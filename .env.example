# ==============================================================================
# COSMOS Spacecraft Flight Operations - Environment Configuration Template
# Copy this file to .env and configure strong, secret values before launching.
# NEVER commit the real .env file or production keys to version control.
# ==============================================================================

# Required: Secret key for signing user session JWT tokens (PyJWT, HS256)
# Minimum 32 characters of high-entropy random string
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-secret-string-min-32-chars

# Required: Secret key for inter-service authentication (Digital Twin <-> MI <-> Generator)
# Passed in the 'X-Service-Key' HTTP header on internal microservice calls
COSMOS_SERVICE_KEY=change-this-to-a-secure-random-service-key-min-32-chars

# Token Lifespan in minutes (Specification requires 15 minutes)
JWT_EXPIRATION_MINUTES=15

# Initial Administrative User Seed (Created automatically in SQLite if not present)
COSMOS_ADMIN_USERNAME=admin
COSMOS_ADMIN_PASSWORD=CosmosFlightOps2026!

# SQLite database path for persistent user credential records
COSMOS_DB_PATH=cosmos_users.db

# Microservice Endpoints
DIGITAL_TWIN_URL=http://127.0.0.1:8000
MISSION_INTELLIGENCE_URL=http://127.0.0.1:8001
COSMOS_GENERATOR_URL=http://127.0.0.1:8080
